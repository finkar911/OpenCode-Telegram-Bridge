# Copy this file to %USERPROFILE%\.config\opencode\telegram.env
# (or set TELEGRAM_ENV_FILE to another path).

# Required: get the token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Required: your numeric Telegram id (see @userinfobot). Only this user is served.
TELEGRAM_OWNER_ID=

# Optional: second factor. Without it the owner id alone is enough.
# TELEGRAM_PIN=1234
TELEGRAM_UNLOCK_MINUTES=720

# Optional: display names for projects, keyed by project id or canonical path.
# TELEGRAM_PROJECT_ALIASES={"my-project-id":"My Project"}

# Optional: OpenCode service overrides. By default the bridge reads
# ~/.local/state/opencode/service.json.
# OPENCODE_URL=http://127.0.0.1:28894
# OPENCODE_PASSWORD=
# OPENCODE_STATE_FILE=C:\Users\you\.local\state\opencode\service.json

# Optional: include subagent sessions in start/finish notifications.
NOTIFY_SUBAGENTS=false

# Optional: error|warn|info|debug
TELEGRAM_LOG_LEVEL=info
